# ==========================================
# Milvus 向量数据库配置
# ==========================================
# 容器运行使用
#docker run -d -p 8000:8000 `
#  --add-host=host.docker.internal:host-gateway `
#  --env-file .env `
#  -e MILVUS_URI="http://host.docker.internal:19530" `
#  --name rag-container `
#  rag-agentic-api
MILVUS_URI=http://localhost:19530
COLLECTION_NAME=rag_docs
# Docker Compose 模式下容器访问宿主 Milvus 的地址
DOCKER_MILVUS_URI=http://host.docker.internal:19530
# 映射到宿主机的 API 端口
APP_PORT=8000
# 与 Embedding 模型输出维度保持一致
EMBEDDING_DIM=1024
# 全量入库时每次请求的文本数量
EMBEDDING_BATCH_SIZE=10

# ==========================================
# Embedding 模型配置（用于将文本转向量）
# ==========================================
EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_BASE_URL=https://api.your-provider.com/v1
EMBEDDING_MODEL=your_embedding_model_name

# ==========================================
# LLM 大语言模型配置（DeepSeek 或其他）
# ==========================================
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# 如果你用的是兼容 OpenAI 格式的代理平台，请取消下面两行的注释并填写
# LLM_API_KEY=your_llm_api_key_here
# LLM_BASE_URL=https://api.your-proxy.com/v1

# ==========================================
# Reranker 精排模型配置 (可选)
# ==========================================
# 是否启用 Reranker：true 或 false
ENABLE_RERANK=false
# 如果用阿里云 Qwen-Rerank，填入 DashScope 的 Key
RERANK_API_KEY=your_rerank_api_key_here
# Reranker 模型及 OpenAI 兼容的重排接口
RERANK_MODEL=qwen3.7-text-rerank
# 完整的 Rerank 请求地址；设置后优先于 RERANK_BASE_URL
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
# 可选：OpenAI 兼容服务的 Base URL，代码会自动换算 Rerank 路径
# RERANK_BASE_URL=https://api.your-provider.com/compatible-mode/v1

# ==========================================
# Agent 策略与系统配置
# ==========================================
# 防止死循环的最大重试次数
MAX_RETRIES=2
# 最终送入大模型的文档块数量 (Top-N)
TOP_N=3
# 混合检索的 Chunk 候选数量，供商品级去重和重排使用
RETRIEVAL_TOP_K=20
# 重排后最终保留的唯一商品数量
RERANK_TOP_PRODUCTS=5
# 每个商品最多保留的检索证据数
RERANK_EVIDENCE_PER_PRODUCT=1
# 送入 Reranker 的单个商品证据最大字符数
RERANK_DOC_MAX_CHARS=4000
# 单次用户问题最大字符数
QUERY_MAX_CHARS=4000
# 多个来源用逗号分隔；生产环境请替换为实际前端域名
CORS_ORIGINS=*

# Ragas 评测使用独立的 .venv-ragas，不参与生产依赖
RAGAS_EVALUATOR_MODEL=deepseek-flash
RAGAS_DO_NOT_TRACK=true
